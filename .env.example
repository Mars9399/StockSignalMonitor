# 可选：Alpaca IEX、Yahoo Finance、Massive / Polygon、IBKR Gateway、IBKR TWS + Yahoo 行情
DATA_PROVIDER=Alpaca IEX

# Alpaca：从控制台复制。不要把真实密钥提交到 Git。
ALPACA_API_KEY=replace_with_your_key
ALPACA_API_SECRET=replace_with_your_secret

# Massive / Polygon：true 使用延迟流；false 请求实时流（取决于订阅）。
MASSIVE_API_KEY=replace_with_your_key
MASSIVE_DELAYED=true

# IB Gateway：Paper 常用 4002，Live 常用 4001。
# 行情类型：1实时、2冻结、3延迟/有权限时实时、4延迟冻结。
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=17
IBKR_MARKET_DATA_TYPE=3

# TWS 只读持仓：Paper 7497，Live 7496。TWS 中启用 Socket API 和 Read-Only API。
TWS_HOST=127.0.0.1
TWS_PORT=7497
TWS_CLIENT_ID=17
TWS_ACCOUNT_ID=

# 逗号分隔的美股代码。
WATCH_SYMBOLS=AAPL,MSFT,NVDA,SPY,QQQ

# 最低 60 秒，默认每 5 分钟扫描。
SCAN_INTERVAL_SECONDS=300

# 可选：填写 Discord Webhook 后发送提示；留空则仅显示并保存 CSV。
DISCORD_WEBHOOK_URL=
